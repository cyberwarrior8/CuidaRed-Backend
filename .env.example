NODE_ENV=development
PORT=3000
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
PWA_ORIGIN=http://localhost:5173
# Configura solo si el proxy de despliegue reemplaza X-Forwarded-For con la IP de origen.
TRUST_PROXY_HOPS=0
# Obligatoria para el backoffice y las invitaciones. Mantener solo en el servidor.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Activa después de aplicar la migración de seguimiento de visitas en el entorno autorizado.
VISITAS_PUBLICAS_HABILITADAS=0
# CODIGO_SEGUIMIENTO_SECRETO=REEMPLAZAR_CON_32_O_MAS_CARACTERES_ALEATORIOS
# Configuración de correos de visita. Usa un remitente de un dominio verificado en Resend.
# VISITAS_RESEND_API_KEY=re_REPLACE_ME
# VISITAS_CORREO_REMITENTE=visitas@example.com
