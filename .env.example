NODE_ENV=development
PORT=3000
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
FRONTEND_ORIGINS=http://localhost:5173
# Clave de 32 bytes en base64url para recuperar sesiones. Genera una por entorno y compártela entre las instancias de la API.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# BROWSER_SESSION_KEY=
# Opcional (CR-160): clave secret del proyecto, solo para invitar miembros nuevos. Nunca la subas ni la uses en el frontend.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Reservado para las solicitudes externas. El flujo sigue deshabilitado.
# CODIGO_SEGUIMIENTO_SECRETO=REEMPLAZAR_CON_32_O_MAS_CARACTERES_ALEATORIOS
# Activa Web Push cuando la persistencia y el emisor estén listos.
WEB_PUSH_ENABLED=false
# WEB_PUSH_PUBLIC_KEY=CLAVE_PUBLICA_VAPID_BASE64URL_SIN_RELLENO
# Solo para el emisor. Conserva la misma pareja de claves por entorno.
# WEB_PUSH_PRIVATE_KEY=CLAVE_PRIVADA_VAPID_BASE64URL_SIN_RELLENO
# WEB_PUSH_VAPID_SUBJECT=mailto:contacto@tu-dominio.example
